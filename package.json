{
  "name": "@locio/react",
  "version": "0.1.0",
  "description": "React address autocomplete for Australian addresses: validation, autocomplete and geocoding from G-NAF",
  "keywords": [
    "react address autocomplete",
    "address autocomplete",
    "address validation",
    "address geocoding",
    "address validation service",
    "australian address api",
    "gnaf",
    "g-naf",
    "address lookup",
    "geocoding",
    "australia",
    "postcode",
    "react",
    "combobox",
    "typeahead"
  ],
  "license": "MIT",
  "homepage": "https://locio.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locio-au/locio-react.git"
  },
  "bugs": {
    "url": "https://github.com/locio-au/locio-react/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
